# Development settings for `npm run dev`. Copy to dev.env (git-ignored) and edit.
PORT=8090
# Either a local/mounted collection (the eXoDOS folder holding eXo/ and Content/) ...
COLLECTION_ROOT=/path/to/eXoDOS
# ... or a remote one over ssh, with local copies of the Content/*.zip metadata:
# COLLECTION_SSH=user@nas.example.lan:/share/eXoDOS
# COLLECTION_SSH_KEY=/home/you/.ssh/id_ed25519
# COLLECTION_SSH_KNOWN_HOSTS=/home/you/.ssh/known_hosts
# DEV_METADATA_DIR=/path/to/dev-data
# MT32_DIR=/path/to/mt32-roms
CACHE_DIR=../dev-data/cache
STATE_DIR=../dev-data/state
# No login proxy in development: everyone is this user.
SINGLE_USER=dev
