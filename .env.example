# Settings for compose.yaml. Copy to .env and edit.

# Your eXoDOS folder (the one holding eXo/ and Content/). Mounted read-only.
EXODOS_PATH=/path/to/eXoDOS

# Single-user mode: everyone reaching the app is this user (no login).
# Leave empty when a login proxy in front sets the Remote-User header.
SINGLE_USER=player

# Where the app listens on the host. Keep 127.0.0.1 unless a proxy on another
# host needs it: anyone who can reach this port can pick any user.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Server-side bundle cache cap in MB (least recently used games go first).
BUNDLE_CACHE_MB=20000
# MAX_BUNDLE_MB=4000
# LARGE_BUNDLE_MB=300
# USER_HEADER=Remote-User
# MEM_LIMIT=1g
# IMAGE=exodiumweb:local
